# ==============================================================================
# 🔑 智慧 POS 與雲端記帳系統 - 環境變數設定檔
# 說明：部署前請複製此檔案為 .env 並填入您的 Supabase 專案金鑰
# ==============================================================================

# 1. Supabase 雲端資料庫連線金鑰 (必填)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. 店家名稱 / 品牌名稱 (選填，預設為 我的智慧門市)
VITE_STORE_NAME=龍城麵線

# 3. 管理員後台預設 PIN 碼 (選填，預設為 8888)
VITE_ADMIN_PIN=8888

# 4. 店家安全管理金鑰 Token (必填，極度重要！用於開啟 POS 與記帳後台入口)
# 範例：設定為 my_secret_token 後，後台網址即為 https://your-domain.com/?pos=my_secret_token
VITE_STAFF_SECRET_TOKEN=admin_8888
